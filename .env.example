# =====================================================================
# Agent-Ready Certifier — environment template
# 1. Copy this file and rename the copy to `.env`
# 2. Fill in the values in `.env` (never in this file)
# 3. `.env` must stay in .gitignore and never be committed
# SANDBOX ONLY: the app must refuse to start with live PayPal hosts/keys.
# =====================================================================

# ---------- General ----------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000          # web app URL (Render URL later)
API_BASE_URL=http://localhost:4000          # API URL (Render URL later)

# ---------- PayPal sandbox (Milestone 1) ----------
PAYPAL_ENV=sandbox                          # must stay "sandbox"
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=                           # Apps & Credentials > your app > Client ID
PAYPAL_CLIENT_SECRET=                       # Apps & Credentials > your app > Secret

# Sandbox buyer (Testing Tools > Sandbox Accounts > Personal account)
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
PAYPAL_SANDBOX_BUYER_VAULT_ID=                # saved PayPal wallet for AI shopper tests (pnpm vault:setup writes it)
LOOKALIKE_MERCHANT_EMAIL=                     # email of a 2nd sandbox business account (A3 lookalike trap)

# ---------- PayPal webhooks (after hosting on Render, Milestone 2) ----------
PAYPAL_WEBHOOK_ID=                          # Apps & Credentials > your app > Webhooks > Webhook ID
WEBHOOK_PUBLIC_URL=                         # public HTTPS URL of the webhook listener

# ---------- Demo store "good" (Milestone 2) ----------
# The demo store is a separate merchant system; these are its own settings.
DEMO_STORE_GOOD_URL=http://localhost:5001       # where the certifier reaches the store
DEMO_STORE_GOOD_WEBHOOK_ID=                     # webhook ID of the STORE's own listener (<store tunnel>/webhooks/paypal)
DEMO_STORE_GOOD_STATUS_KEY=                     # private status key (pnpm store:keys writes it; never commit)
DEMO_STORE_GOOD_OWNERSHIP_TOKEN=                # public ownership token the store serves (pnpm store:keys writes it)

# ---------- Demo store "buggy" (Milestone 5) ----------
# Separate merchant with SEEDED BUGS and its own throwaway sandbox app (one bug exposes its secret).
DEMO_STORE_BUGGY_URL=http://localhost:5002
DEMO_STORE_BUGGY_PAYPAL_CLIENT_ID=              # sandbox app "demo-store-buggy" > Client ID
DEMO_STORE_BUGGY_PAYPAL_CLIENT_SECRET=          # sandbox app "demo-store-buggy" > Secret
DEMO_STORE_BUGGY_WEBHOOK_ID=                    # the buggy store's own webhook (pnpm webhooks:ensure writes it)
DEMO_STORE_BUGGY_CERTIFIER_WEBHOOK_ID=          # the certifier's copy on the buggy app (pnpm webhooks:ensure writes it)
DEMO_STORE_BUGGY_STATUS_KEY=                    # private status key (pnpm store:keys writes it)
DEMO_STORE_BUGGY_OWNERSHIP_TOKEN=               # public ownership token (pnpm store:keys writes it)

# ---------- Second sandbox merchant for the lookalike trap (Milestone 6) ----------
PAYPAL_LOOKALIKE_CLIENT_ID=                 # a second sandbox app/business account
PAYPAL_LOOKALIKE_CLIENT_SECRET=

# ---------- Database and queue (Render) ----------
DATABASE_URL=postgres://user:password@localhost:5432/certifier
QUEUE_URL=redis://localhost:6379            # Render Key Value URL later

# ---------- AI model ----------
LLM_PROVIDER=                               # e.g. anthropic
LLM_API_KEY=
LLM_MODEL=                                  # model name used for agents
GEMINI_API_KEY=                             # second model provider for the A2 scorecard (Milestone 6)

# ---------- Sponsor tools ----------
KERNEL_API_KEY=                             # dashboard.onkernel.com (cloud browsers, Milestone 3)
CHANNEL3_API_KEY=                           # Channel3 product data (demo stores and traps)
APIMATIC_CONTEXT_MCP_URL=https://chatbotapi.apimatic.io/mcp/plugins   # diagnosis agent grounding

# ---------- Safety limits ----------
RUN_MAX_REQUESTS=300                        # request budget per run
RUN_MAX_MINUTES=20                          # time limit per run
WEBHOOK_WAIT_SECONDS=180                    # how long to wait before marking events "delayed"/"missing"

# ---------- Ownership verification ----------
OWNERSHIP_TOKEN_SECRET=                     # random long string used to generate store tokens
CERTIFIER_ADMIN_TOKEN=                      # protects Run API start/stop (pnpm store:keys generates it)

# ---------- Trust layer (Milestone 8, stretch) ----------
CERT_SIGNING_PRIVATE_KEY=                   # issuer key for signed certificates (server-side only)
WEBAUTHN_RP_ID=localhost                    # passkey relying-party domain (Render domain later)
WEBAUTHN_RP_NAME=Agent-Ready Certifier
TESTNET_RPC_URL=                            # public testnet RPC for the hash log
TESTNET_WALLET_PRIVATE_KEY=                 # testnet-only wallet, never a real one
