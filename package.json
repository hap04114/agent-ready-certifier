{
  "name": "agent-ready-certifier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "check:env": "tsx packages/config/src/cli.ts",
    "dev:api": "pnpm --filter @certifier/api dev",
    "dev:store-good": "pnpm --filter @certifier/demo-stores dev:good",
    "verify:order": "pnpm --filter @certifier/demo-stores verify:order",
    "scan:secrets": "gitleaks git --redact --no-banner . && gitleaks git --pre-commit --staged --redact --no-banner && pnpm --silent scan:env-values",
    "scan:env-values": "tsx packages/config/src/scan-env-values.ts",
    "lint": "biome lint .",
    "works:run": "pnpm --filter @certifier/worker works:run",
    "db:up": "docker compose up -d db",
    "store:keys": "tsx packages/contract/src/keys-cli.ts",
    "paypal:cross-read": "pnpm --filter @certifier/worker paypal:cross-read",
    "webhooks:sync": "pnpm --filter @certifier/worker webhooks:sync",
    "agent:shop": "pnpm --filter @certifier/browser-agent agent:shop",
    "webhooks:ensure": "pnpm --filter @certifier/worker webhooks:ensure",
    "env:copy": "tsx packages/config/src/copy-cli.ts",
    "render:sync": "tsx packages/config/src/render-sync.ts",
    "probe:page": "pnpm --filter @certifier/probes probe:page",
    "scorecard": "pnpm --filter @certifier/worker scorecard",
    "vault:setup": "pnpm --filter @certifier/worker vault:setup",
    "demo:export": "pnpm --filter @certifier/api demo:export",
    "diagnose": "pnpm --filter @certifier/worker diagnose",
    "apimatic:register": "pnpm --filter @certifier/diagnosis apimatic:register",
    "benchmark": "pnpm --filter @certifier/worker benchmark",
    "cert:keygen": "pnpm --filter @certifier/api cert:keygen",
    "cert:issue": "pnpm --filter @certifier/api cert:issue",
    "certify:page": "pnpm --filter @certifier/worker certify:page",
    "realworld:serve": "pnpm --filter @certifier/worker realworld:serve",
    "thirdparty:run": "pnpm --filter @certifier/worker thirdparty:run",
    "merchant-agent": "pnpm --filter @certifier/worker merchant-agent",
    "funnel": "pnpm --filter @certifier/worker funnel",
    "passkey:invite": "pnpm --filter @certifier/api passkey:invite",
    "bypass-demo": "pnpm --filter @certifier/worker bypass-demo",
    "simulator:export": "pnpm --filter @certifier/api simulator:export"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
